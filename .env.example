# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Sultan Kudarat Research Journal of Education and Technology (SKRJET)"

# PostgreSQL — local, Supabase, or Neon
# Local:  postgresql://postgres:postgres@localhost:5432/journal_platform?schema=public
# Neon:   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Supabase: postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/journal_platform?schema=public"

# Authentication (Auth.js + journal_session cookie)
# openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
AUTH_URL=http://localhost:3000
AUTH_COOKIE_NAME=journal_session
AUTH_CSRF_COOKIE_NAME=journal_csrf
AUTH_SESSION_TTL_HOURS=12

# File storage: local | s3 | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.storage

# S3-compatible object storage (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=journal-platform
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Supabase Storage (required when STORAGE_DRIVER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=journal-files

# Upload limits (overridable per journal in settings)
MAX_PDF_SIZE_MB=25
MAX_SUPPLEMENTARY_SIZE_MB=50
MAX_THUMBNAIL_SIZE_MB=5

# EDAS integration: mock | manual | live
# mock  — development adapter that never calls a remote API
# manual — store EDAS Paper IDs entered by editors
# live   — reserved for a future authenticated EDAS client
EDAS_MODE=mock
EDAS_BASE_URL=
EDAS_API_KEY=
EDAS_API_SECRET=
EDAS_TIMEOUT_MS=15000

# Crossref DOI registration: mock | manual | live
CROSSREF_MODE=mock
CROSSREF_API_URL=https://doi.crossref.org
CROSSREF_LOGIN=
CROSSREF_PASSWORD=
CROSSREF_DEPOSITOR_NAME=
CROSSREF_DEPOSITOR_EMAIL=
CROSSREF_PREFIX=10.5555

# ORCID researcher identity: mock | live (public ORCID API)
ORCID_MODE=mock
ORCID_API_URL=https://pub.orcid.org/v3.0
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Google Search Console site verification token (optional)
GOOGLE_SITE_VERIFICATION=

# Outbound email for reviewer/account invites: mock | live
# mock — stores messages in memory and logs them (development)
# live — sends through Resend (https://resend.com)
EMAIL_MODE=mock
EMAIL_FROM="SKRJET <noreply@journals.local>"
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

# Metrics
METRIC_DEDUPE_WINDOW_SECONDS=3600
